# Maintainer: Mishkah-Note contributors <noreply@github.com>
# Build:        cd packaging/arch && makepkg -si
# Check:        namcap PKGBUILD  ·  makepkg --printsrcinfo > .SRCINFO

pkgname=mishkah-note
pkgver=1.0.01
pkgrel=1
pkgdesc="Windows 11-style text editor with first-class Arabic, RTL and Markdown support"
arch=('any')
url="https://github.com/bifa90/Mishkah-Note"
license=('MIT')
depends=('python' 'pyside6' 'python-charset-normalizer')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
optdepends=(
    'noto-fonts: Devanagari, Bengali, Cyrillic and CJK coverage'
    'noto-fonts-cjk: Chinese interface and documents'
    'ttf-liberation: Latin fallback'
)
provides=('mishkah')
conflicts=('mishkah')
options=('!strip' '!emptydirs')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "Mishkah-Note-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "Mishkah-Note-$pkgver"

    python -m installer --destdir="$pkgdir" dist/*.whl

    install -Dm644 packaging/common/mishkah.desktop \
        "$pkgdir/usr/share/applications/mishkah-note.desktop"
    install -Dm644 packaging/common/org.mishkahnote.Mishkah.metainfo.xml \
        "$pkgdir/usr/share/metainfo/org.mishkahnote.Mishkah.metainfo.xml"

    for size in 16 24 32 48 64 128 256 512; do
        install -Dm644 "src/mishkah/resources/icons/app-${size}.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/mishkah-note.png"
    done
    install -Dm644 src/mishkah/resources/icons/app.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/mishkah-note.svg"

    install -Dm644 packaging/common/mishkah.1 \
        "$pkgdir/usr/share/man/man1/mishkah.1"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
